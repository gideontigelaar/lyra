---
import BroadcastIcon from '@phosphor-icons/core/assets/fill/broadcast-fill.svg';
import SquaresFourIcon from '@phosphor-icons/core/assets/fill/squares-four-fill.svg';
import ThermometerIcon from '@phosphor-icons/core/assets/fill/thermometer-simple-fill.svg';

interface Props {
  current?: string;
  variant: 'top' | 'bottom';
}

const { current, variant } = Astro.props;

const tabs = [
  { id: 'summary', label: 'Summary', href: '/', Icon: SquaresFourIcon },
  { id: 'sensors', label: 'Sensors', href: '/sensors/', Icon: ThermometerIcon },
  { id: 'sources', label: 'Sources', href: '/sources/', Icon: BroadcastIcon },
];
---

<nav
  aria-label="Main"
  class:list={[
    'rounded-full border border-line/70 bg-surface/80 p-1 shadow-lg shadow-navy-950/5 backdrop-blur-xl',
    variant === 'top' ? 'hidden md:flex' : 'fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-20 mx-auto flex w-fit md:hidden',
  ]}
>
  {
    tabs.map(({ id, label, href, Icon }) => (
      <a
        href={href}
        aria-current={id === current ? 'page' : undefined}
        class:list={[
          'flex items-center rounded-full font-semibold transition-colors aria-[current=page]:bg-fill aria-[current=page]:text-accent',
          variant === 'top' ? 'gap-2 px-4 py-1.5 text-sm' : 'min-w-20 flex-col gap-0.5 px-4 py-1.5 text-[11px]',
        ]}
      >
        <Icon class={variant === 'top' ? 'size-5' : 'size-6'} aria-hidden="true" />
        {label}
      </a>
    ))
  }
</nav>