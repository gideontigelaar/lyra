---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
  <div class="mx-auto w-full max-w-sm text-center">
    <h1 class="text-[34px] font-bold tracking-tight">Page not found</h1>
    <p class="mt-2 text-[17px] text-muted">This page doesn't exist.</p>
    <a href="/" class="mt-6 inline-block text-[17px] font-semibold text-accent">Go to Summary</a>
  </div>
</Layout>