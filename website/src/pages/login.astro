---
import KeyIcon from '@phosphor-icons/core/assets/fill/key-fill.svg';
import Wordmark from '../components/Wordmark';
import Layout from '../layouts/Layout.astro';
import { card, primaryButton, secondaryButton } from '../lib/ui';
---

<Layout title="Sign in">
  <div class:list={[card, 'mx-auto w-full max-w-sm p-8 text-center']}>
    <h1 class="sr-only">Sign in</h1>
    <Wordmark className="mx-auto h-10 w-auto" />
    <button type="button" class:list={[primaryButton, 'mt-8 w-full py-3 text-body']} data-sign-in>
      <KeyIcon class="size-5" aria-hidden="true" />
      Sign in with a passkey
    </button>
    <p class="mt-3 text-subheadline text-muted" hidden data-unsupported>This browser is too old for passkey sign-in. Update it or use another browser.</p>
    <button type="button" class:list={[secondaryButton, 'mt-3 w-full py-3 text-body']} data-demo>Try the demo</button>
    <p class="mt-6 text-subheadline text-muted" hidden data-setup>First time here? <a href="/setup/" class="font-semibold text-accent">Use a setup code</a></p>
  </div>
</Layout>

<script>
  import { ApiError, api } from '../lib/api';
  import { passkeyError, passkeysSupported, signIn } from '../lib/passkeys';
  import { endDemo, rememberSignIn, startDemo } from '../lib/session';
  import { showError } from '../lib/toast';

  const button = document.querySelector<HTMLButtonElement>('[data-sign-in]')!;
  const setup = document.querySelector<HTMLElement>('[data-setup]')!;

  api<{ available: boolean }>('/auth/setup').then(
    ({ available }) => (setup.hidden = !available),
    () => {},
  );

  if (!passkeysSupported()) {
    button.disabled = true;
    document.querySelector<HTMLElement>('[data-unsupported]')!.hidden = false;
  }

  document.querySelector('[data-demo]')!.addEventListener('click', () => {
    startDemo();
    location.assign('/');
  });

  button.addEventListener('click', async () => {
    button.disabled = true;

    try {
      await signIn();
      endDemo();
      rememberSignIn();
      location.assign('/');
    } catch (e) {
      showError(e instanceof ApiError && e.status === 401 ? "This passkey isn't registered here." : passkeyError(e));
      button.disabled = false;
    }
  });
</script>