---
import KeyIcon from '@phosphor-icons/core/assets/fill/key-fill.svg';
import Wordmark from '../components/Wordmark';
import Layout from '../layouts/Layout.astro';
import { card, input, label, widePrimaryButton } from '../lib/ui';
---

<Layout title="Set up">
  <div class="mx-auto w-full max-w-sm">
    <form class:list={[card, 'p-8']} data-setup>
      <Wordmark className="mx-auto h-10 w-auto" />
      <h1 class="mt-6 text-center text-xl font-bold tracking-tight">Set up a passkey</h1>
      <p class="mt-1 text-center text-subheadline text-muted">Enter your setup code to create your first passkey.</p>
      <label for="setup-code" class:list={[label, 'mt-6']}>Setup code</label>
      <input id="setup-code" name="code" class={input} autocomplete="one-time-code" spellcheck="false" required />
      <label for="passkey-name" class:list={[label, 'mt-4']}>Passkey name</label>
      <input id="passkey-name" name="name" class={input} maxlength="50" required />
      <button type="submit" class:list={[widePrimaryButton, 'mt-6']}>
        <KeyIcon class="size-5" aria-hidden="true" />
        Create passkey
      </button>
      <p class="mt-3 text-subheadline text-muted" hidden data-unsupported>This browser is too old to create a passkey. Update it or use another browser.</p>
      <p class="mt-6 text-center text-subheadline text-muted">Already have a passkey? <a href="/login/" class="font-semibold text-accent">Sign in</a></p>
    </form>
  </div>
</Layout>

<script>
  import { ApiError } from '../lib/api';
  import { passkeyError, passkeysSupported, registerPasskey } from '../lib/passkeys';
  import { rememberSignIn } from '../lib/session';
  import { showError } from '../lib/toast';

  const form = document.querySelector<HTMLFormElement>('[data-setup]')!;
  const button = form.querySelector<HTMLButtonElement>('button')!;

  if (!passkeysSupported()) {
    button.disabled = true;
    form.querySelector<HTMLElement>('[data-unsupported]')!.hidden = false;
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    button.disabled = true;
    const data = new FormData(form);

    try {
      await registerPasskey(String(data.get('name')), String(data.get('code')).trim());
      rememberSignIn();
      location.assign('/');
    } catch (e) {
      showError(e instanceof ApiError && e.status === 401 ? 'This setup code is invalid or has expired.' : passkeyError(e));
      button.disabled = false;
    }
  });
</script>