---
import GearSixIcon from '@phosphor-icons/core/assets/fill/gear-six-fill.svg';
import TabBar from '../components/TabBar.astro';
import Wordmark from '../components/Wordmark.astro';
import { iconButton } from '../lib/ui';
import { signInScript, themeScript } from '../scripts/inline.mjs';
import '../styles/global.css';

interface Props {
  title?: string;
  tab?: 'summary' | 'sensors' | 'sources';
  app?: boolean;
  wide?: boolean;
}

const { title, tab, app = false, wide = false } = Astro.props;
const settings = Astro.url.pathname === '/settings/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#eef1f8" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title ? `${title} · Lyra` : 'Lyra'}</title>
    <script is:inline set:html={themeScript} />
    {app && !import.meta.env.DEV && <script is:inline set:html={signInScript} />}
  </head>
  <body class="min-h-dvh bg-bg text-navy-950 antialiased dark:text-navy-50">
    {
      app && (
        <header class="sticky top-0 z-20 border-b border-line/60 bg-bg/80 backdrop-blur-xl">
          <div class="mx-auto flex h-14 max-w-4xl items-center justify-between gap-4 px-4 sm:px-6">
            <a href="/" class="rounded-md" aria-label="Lyra summary">
              <Wordmark class="h-5 w-auto" />
            </a>
            <TabBar current={tab} variant="top" />
            <a href="/settings/" class={iconButton} aria-label="Settings" aria-current={settings ? 'page' : undefined}>
              <GearSixIcon class="size-6" aria-hidden="true" />
            </a>
          </div>
        </header>
      )
    }
    <main class:list={['mx-auto w-full px-4 sm:px-6', wide ? 'max-w-4xl' : 'max-w-3xl', app ? 'pt-6 pb-32 md:pb-16' : 'flex min-h-dvh flex-col justify-center py-10']}>
      <slot />
    </main>
    {app && <TabBar current={tab} variant="bottom" />}
  </body>
</html>